# ===================================================================
# TAPIZ FRESH - VARIABLES DE ENTORNO
# ===================================================================

# 1. SUPABASE (Para Base de Datos y Sincronización en Tiempo Real)
# Obtén estos valores en tu panel de Supabase -> Project Settings -> API
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu_clave_anonima_publica_aqui"

# 2. BREVO (API REST para Envío Directo de Correos y Códigos OTP)
# Ve a brevo.com -> Menú superior derecho -> "SMTP y API" -> Pestaña "Claves API" (no Claves SMTP) -> Generar nueva clave
# IMPORTANTE: La clave API de Brevo siempre empieza por "xkeysib-"
BREVO_API_KEY="xkeysib-tu_clave_api_v3_aqui"

# Correo y Nombre del Remitente (debe estar verificado en tu cuenta de Brevo)
BREVO_SENDER_EMAIL="tapizoma2026@gmail.com"
BREVO_SENDER_NAME="Tapiz Fresh Bogotá"

# 3. URL DE LA APLICACIÓN
# En producción en Render será algo como: https://tapiz-fresh.onrender.com
APP_URL="https://tapiz-fresh.onrender.com"
