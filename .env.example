# ===================================================================
# TAPIZ FRESH - VARIABLES DE ENTORNO
# ===================================================================

# 1. SUPABASE (Para Base de Datos y Autenticación en Tiempo Real)
# Obtén estos valores en tu panel de Supabase -> Project Settings -> API
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu_clave_anonima_publica_aqui"

# 2. BREVO (SMTP & Transactional Emails)
# Configura estos datos en Supabase -> Project Settings -> Authentication -> SMTP Settings
# Obtén tu clave en Brevo -> SMTP & API -> Claves SMTP
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER="tu-correo-registrado-en-brevo@gmail.com"
BREVO_SMTP_KEY="tu-clave-smtp-generada-en-brevo"
BREVO_SENDER_EMAIL="tapizoma2026@gmail.com"
BREVO_SENDER_NAME="Tapiz Fresh Bogotá"

# 3. URL DE LA APLICACIÓN
# En producción en Render será algo como: https://tapiz-fresh.onrender.com
APP_URL="https://tapiz-fresh.onrender.com"
